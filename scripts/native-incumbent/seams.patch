+// ---- native S04 and S05 (terminal row), judged on the incumbent ------------
+//
+// The repaired instrument reaches unknown status through a failed Started
+// check. The incumbent has no start check, so the fixture does not claim that
+// path. It reaches `Lease::reclaim(None, false)` the way the incumbent itself
+// can: its supervision loop's observation fails, it sends SIGKILL, and its
+// reap then fails too, which leaves recovery with no status. Both reports are
+// substituted at operations the incumbent performs (the physical `waitid`
+// has run; the physical `wait` is omitted so the fixture, not the product,
+// holds the reservation and reaps it afterwards). The terminal operations,
+// foreground and modes are the real ones on the role's own PTY, and a
+// substituted report follows its physical operation exactly as in the repaired
+// rows. `start-check-source-retained` has no counterpart: its fact (a start
+// check's error) cannot exist.
+
+/// One row, as a role process on its own PTY. Every claim is judged after the
+/// fixture's own foreground, modes and holder are settled, so a violated claim
+/// never leaves the PTY dirty. `C4_BROKEN=report` is the harness control that
+/// discards the substituted report.
+fn native_s04_role(terminal: Terminal, saved: libc::termios, case: &str) {
+    let row = case.strip_prefix("native-baseline-").unwrap();
+    let kind = std::env::var("C4_BROKEN").ok();
+    let own = own_group();
+    let bits = match row {
+        "foreground-query-EIO" => QUERY,
+        "handback-EIO" => HANDBACK,
+        "modes-EIO" | "s05-modes" => MODES,
+        "SIGTTOU-restore-EIO" => TTOU,
+        _ => 0,
+    };
+    super::baseline_tests::unknown_status(true);
+    S04.set(true);
+    FAULTS.set(bits);
+    CANCEL.set(row == "s05-modes");
+    HAND_OWN.set(row == "foreground-own");
+    match kind.as_deref() {
+        None => {}
+        Some("report") => DROP_REPORTS.set(true),
+        Some(other) => panic!("unknown baseline control {other}"),
+    }
+    let mut holder = (row == "foreground-unrelated").then(|| {
+        Command::new("/bin/sleep")
+            .arg("20")
+            .process_group(0)
+            .spawn()
+            .unwrap()
+    });
+    let holder_pid = holder.as_ref().map(|child| child.id() as i32);
+    if let Some(pid) = holder_pid {
+        FOREIGN.set(pid);
+    }
+    let argv = crate::Argv::new("/usr/bin/true".into(), vec![]);
+    let mut events = Vec::new();
+    let result = run_observed(
+        Launch {
+            argv: &argv,
+            channel: None,
+            scrub: &[],
+            grant: &[],
+            transparent: None,
+            cwd: None,
+            escalation: Escalation {
+                grace: Duration::ZERO,
+                kill_grace: Duration::ZERO,
+            },
+        },
+        &mut |event| events.push(event),
+    );
+    // Observe first, then settle the fixture, then judge.
+    let after = terminal.foreground();
+    let modes = local_modes(&terminal);
+    let second_latch = LATCH_AT_SECOND.get();
+    let pending = take_interrupt();
+    let child_group = CHILD_AT_SPAWN.get();
+    FOREIGN.set(0);
+    super::baseline_tests::unknown_status(false);
+    S04.set(false);
+    FAULTS.set(0);
+    CANCEL.set(false);
+    HAND_OWN.set(false);
+    DROP_REPORTS.set(false);
+    let recovered = terminal
+        .hand_to(own)
+        .and_then(|()| terminal.restore(&saved));
+    // The product never reaped (its wait failed), so the physical child is
+    // still a zombie the fixture alone owns: reap it, bounded.
+    let child_reap = super::baseline_tests::fixture_reap();
+    let physical_reaps = super::baseline_tests::physical_reaps();
+    let cleanup = holder.as_mut().map(|child| {
+        let until = Instant::now() + Duration::from_secs(2);
+        let mut killed = false;
+        loop {
+            match child.try_wait() {
+                Ok(Some(status)) => break Ok(status),
+                Err(error) => break Err(error),
+                Ok(None) => {}
+            }
+            if !killed {
+                child.kill().unwrap();
+                killed = true;
+            }
+            if Instant::now() >= until {
+                break Err(std::io::Error::new(
+                    std::io::ErrorKind::TimedOut,
+                    "foreign fixture cleanup unconfirmed",
+                ));
+            }
+            std::thread::sleep(Duration::from_millis(1));
+        }
+    });
+    let (text, consumed) = match &result {
+        Ok(ended) => (
+            format!("ended end={:?} group={:?}", ended.end, ended.group),
+            None,
+        ),
+        Err(error) => (error.to_string(), error.consumed_signal()),
+    };
+    let restored = modes == saved.c_lflag & !libc::PENDIN;
+    eprintln!("native baseline S04 row={row} control={kind:?}: physical_reaps={physical_reaps} events={events:?} foreground={after} own={own} child_group={child_group} holder={holder_pid:?} modes_restored={restored} second_latch={second_latch} pending={pending:?} consumed={consumed:?} cleanup={cleanup:?} result={text}");
+    assert!(
+        cleanup.as_ref().is_none_or(Result::is_ok),
+        "fixture cleanup"
+    );
+    recovered.unwrap();
+    child_reap.expect("fixture child reap must settle on every row");
+    let mut claims = Vec::new();
+    let mut claim = |held: bool, name: &str| {
+        if !held {
+            claims.push(name.to_owned());
+        }
+    };
+    claim(
+        events
+            .iter()
+            .filter(|&&event| event == LaunchEvent::Reaped)
+            .count()
+            == physical_reaps as usize,
+        "reaped-only-on-actual-reap",
+    );
+    let diagnostics = text.contains("terminal") || text.contains("unconfirmed");
+    match row {
+        "foreground-own" => {
+            claim(after == own, "launcher-foreground-kept");
+            claim(restored, "saved-modes-restored");
+            claim(!diagnostics, "no-invented-recovery-diagnostic");
+        }
+        "foreground-child" => {
+            claim(after == own, "recorded-child-group-handed-back");
+            claim(restored, "saved-modes-restored");
+            claim(!diagnostics, "no-invented-recovery-diagnostic");
+        }
+        "foreground-unrelated" => {
+            claim(Some(after) == holder_pid, "foreign-foreground-preserved");
+            claim(
+                text.contains("unconfirmed") && text.contains("foreground"),
+                "unconfirmed-foreground-reported",
+            );
+            claim(text.contains("mode"), "unconfirmed-modes-reported");
+            claim(!restored, "saved-modes-not-applied-to-a-foreign-holder");
+        }
+        "foreground-query-EIO" => {
+            claim(
+                text.contains("terminal foreground query failed"),
+                "query-report-retained",
+            );
+            claim(after == child_group, "no-handback-after-failed-query");
+        }
+        "handback-EIO" => {
+            claim(
+                text.contains("terminal handback failed"),
+                "handback-report-retained",
+            );
+            claim(after == own, "physical-handback-performed");
+            claim(restored, "saved-modes-restored");
+        }
+        "modes-EIO" => {
+            claim(
+                text.contains("terminal mode restoration failed"),
+                "modes-report-retained",
+            );
+            claim(restored, "physical-restoration-performed");
+        }
+        "SIGTTOU-restore-EIO" => {
+            claim(
+                text.contains("temporary SIGTTOU restoration failed"),
+                "sigttou-report-retained",
+            );
+            claim(after == own && restored, "physical-operations-performed");
+        }
+        "s05-modes" => {
+            claim(
+                text.contains("terminal mode restoration failed"),
+                "modes-report-retained",
+            );
+            claim(
+                consumed == Some(libc::SIGHUP),
+                "first-consumption-retained",
+            );
+            claim(
+                second_latch == 0,
+                "first-consumption-acknowledged-before-second",
+            );
+            claim(
+                pending == Some(libc::SIGTERM),
+                "second-signal-pending-not-consumed",
+            );
+            claim(after == own && restored, "physical-operations-performed");
+        }
+        other => panic!("unknown S04 row {other}"),
+    }
+    assert!(
+        claims.is_empty(),
+        "S04 claim violated: {}",
+        claims.join(", ")
+    );
+}
+
+/// Run one role on its own PTY under the shared controller and judge the
+/// incumbent: `Ok(note)` when every claim held, `Err(claims)` naming each one
+/// the incumbent did not meet. Any other way the role can fail is the
+/// instrument's, and panics here without a verdict.
+fn baseline_pty(case: &str, control: Option<&str>) -> Result<String, String> {
+    use crate::native_barrier::{Controller, Limits};
+    let root = tempfile::tempdir().unwrap();
+    let (mut master, mut slave) = (-1, -1);
+    assert_eq!(
+        unsafe {
+            libc::openpty(
+                &mut master,
+                &mut slave,
+                std::ptr::null_mut(),
+                std::ptr::null_mut(),
+                std::ptr::null_mut(),
+            )
+        },
+        0
+    );
+    let (mut master, slave) = unsafe { (File::from_raw_fd(master), File::from_raw_fd(slave)) };
+    for fd in [master.as_raw_fd(), slave.as_raw_fd()] {
+        assert_eq!(
+            unsafe { libc::fcntl(fd, libc::F_SETFD, libc::FD_CLOEXEC) },
+            0
+        );
+    }
+    let mut command = Command::new(std::env::current_exe().unwrap());
+    command
+        .args([
+            "--exact",
+            ROLE,
+            "--ignored",
+            "--nocapture",
+            "--test-threads=1",
+        ])
+        .env("C4_CASE", case)
+        .env("C4_ROOT", root.path())
+        .stdin(slave.try_clone().unwrap())
+        .stdout(slave.try_clone().unwrap())
+        .stderr(slave);
+    if let Some(kind) = control {
+        command.env("C4_BROKEN", kind);
+    }
+    // SAFETY: only child-safe syscalls, establishing this fixture's own PTY.
+    unsafe {
+        command.pre_exec(|| {
+            if libc::setsid() == -1 || libc::ioctl(0, libc::TIOCSCTTY as _, 0) == -1 {
+                return Err(std::io::Error::last_os_error());
+            }
+            Ok(())
+        });
+    }
+    // The shared controller owns the fixture: its 30-second envelope bounds
+    // every wait and it alone stops and reaps the identity on a failed case.
+    let barrier = root.path().join("barrier");
+    std::fs::create_dir(&barrier).unwrap();
+    let mut controller = Controller::new(&barrier, Limits::FROZEN).unwrap();
+    controller.adopt(command.spawn().unwrap());
+    drop(command);
+    let flags = unsafe { libc::fcntl(master.as_raw_fd(), libc::F_GETFL) };
+    assert_eq!(
+        unsafe { libc::fcntl(master.as_raw_fd(), libc::F_SETFL, flags | libc::O_NONBLOCK) },
+        0
+    );
+    let until = Instant::now() + Duration::from_secs(12);
+    let mut output = Vec::new();
+    let status = loop {
+        drain(&mut master, &mut output);
+        if let Some(status) = controller.poll().unwrap() {
+            break status;
+        }
+        if Instant::now() >= until {
+            let settlement = controller.abort();
+            panic!(
+                "baseline fixture did not finish: {settlement:?}: {}",
+                String::from_utf8_lossy(&output)
+            );
+        }
+        std::thread::sleep(Duration::from_millis(2));
+    };
+    drain(&mut master, &mut output);
+    let settlement = controller.finish();
+    assert!(
+        settlement.clean(),
+        "baseline fixture ownership did not settle cleanly: {settlement:?}"
+    );
+    let text = String::from_utf8_lossy(&output).replace(['\r', '\n'], " ");
+    eprintln!("native baseline case={case} control={control:?}: {text}");
+    if status.success() {
+        return Ok(text);
+    }
+    match text.split("S04 claim violated: ").nth(1) {
+        Some(violated) => Err(violated.split("   ").next().unwrap_or_default().trim().to_owned()),
+        None => panic!("baseline role failed for a reason that is not a claim: {status:?}: {text}"),
+    }
+}
+
+/// The identity of a manifest row, read from the frozen manifest.
+fn manifest_has(id: &str) -> bool {
+    let path = std::path::Path::new(env!("CARGO_MANIFEST_DIR")).join("../../docs/native-entry-cases.json");
+    std::fs::read_to_string(&path)
+        .unwrap_or_else(|e| panic!("{}: {e}", path.display()))
+        .contains(&format!("\"id\": \"{id}\""))
+}
+
+/// The role's own fact line, without the test harness around it.
+fn trimmed(text: &str) -> String {
+    text.find("native baseline S04 row=")
+        .map_or(text, |at| &text[at..])
+        .trim()
+        .to_owned()
+}
+
+fn baseline_row(id: &str, row: &str) {
+    assert!(manifest_has(id), "{id} is not a frozen manifest row");
+    let (conforms, note) = match baseline_pty(&format!("native-baseline-{row}"), None) {
+        Ok(text) => (true, trimmed(&text)),
+        Err(claims) => (false, format!("violated: {claims}")),
+    };
+    crate::native_barrier::row(id, "baseline", conforms, &note);
+}
+
+macro_rules! baseline_s04 {
+    ($name:ident, $row:literal) => {
+        #[test]
+        fn $name() {
+            baseline_row(concat!("S04__recovery=", $row), $row);
+        }
+    };
+}
+baseline_s04!(native_baseline_s04_foreground_own, "foreground-own");
+baseline_s04!(native_baseline_s04_foreground_child, "foreground-child");
+baseline_s04!(native_baseline_s04_foreground_unrelated, "foreground-unrelated");
+baseline_s04!(native_baseline_s04_foreground_query_eio, "foreground-query-EIO");
+baseline_s04!(native_baseline_s04_handback_eio, "handback-EIO");
+baseline_s04!(native_baseline_s04_modes_eio, "modes-EIO");
+baseline_s04!(native_baseline_s04_sigttou_restore_eio, "SIGTTOU-restore-EIO");
+
+/// S05's terminal row: HUP is consumed first, TERM arrives during recovery
+/// reports, and the failed mode report must still be retained.
+#[test]
+fn native_baseline_s05_terminal_hup_then_term_keeps_the_first_signal_and_the_mode_report() {
+    baseline_row(
+        "S05__signals=HUP-then-TERM__secondary=S04-modes-EIO",
+        "s05-modes",
+    );
+}
+
+// A harness control: the same role against the incumbent with its substituted
+// report discarded must be seen to fail the claim that names it, so the rows
+// above that read "holds" are not an instrument that reads true everywhere.
+#[test]
+fn native_baseline_control_s04_a_discarded_report_is_detected() {
+    for (row, claim) in [
+        ("modes-EIO", "modes-report-retained"),
+        ("handback-EIO", "handback-report-retained"),
+    ] {
+        let case = format!("native-baseline-{row}");
+        assert!(
+            baseline_pty(&case, None).is_ok(),
+            "{row}: the incumbent was expected to retain its report"
+        );
+        match baseline_pty(&case, Some("report")) {
+            Err(claims) => assert!(
+                claims.contains(claim),
+                "{row}: failed, but not the claim {claim}: {claims}"
+            ),
+            Ok(text) => panic!("{row}: a discarded report was not detected: {text}"),
+        }
+    }
+}
