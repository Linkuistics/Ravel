@startuml
!pragma layout smetana
!include _style.puml
title Control: a UML state machine
[*] --> Selecting
Selecting --> Supervising : route found
Selecting --> Refused : no route
Supervising --> Exited : status 0
Supervising --> Signalled : signal
Exited --> [*]
Signalled --> [*]
Refused --> [*]
@enduml
