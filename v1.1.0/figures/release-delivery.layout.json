    {
      "id": "key-text",
      "shape": "text",
      "role": "label",
      "face": "body",
      "text": "Blue: sequential actions. Grey: stop and recover manually.\nA failure stops at its own step. Later actions do not run.\nEach guard covers the actions since the previous decision.\nEight grey exits name recovery points in the chapter’s recovery table.\nThe book build stays local. The Pages branch push precedes the tap.\nAfter a version write, keep that version. Do not start another version cut.\nA source/tag mismatch needs a decision. Never move a public tag.\nTask removes its lock on exit. After an abrupt stop, check for a live task first.",
      "x": 387.953125,
      "y": 2378.478125,
      "anchor": "center",
      "align": "center",
      "wrapped": false,
      "w": 537.27734375,
      "h": 138.99375
    }
