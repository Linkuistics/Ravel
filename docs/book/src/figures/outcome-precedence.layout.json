    {
      "id": "key-text",
      "shape": "text",
      "role": "label",
      "face": "body",
      "text": "Blue: steps. Grey: outcomes. A diamond is a decision.\nThe label in square brackets is the guard of a flow.\nRavel attempts all cleanup steps before it chooses an outcome.\nThe decisions run in precedence order: the first that applies gives the outcome.\nCancellation wins over every failure. An original failure keeps its own status.\nThe write happens only when every earlier decision passes.",
      "x": 369.8759765625,
      "y": 891.440625,
      "anchor": "center",
      "align": "center",
      "wrapped": false,
      "w": 559.0908203125,
      "h": 102.3203125
    }
