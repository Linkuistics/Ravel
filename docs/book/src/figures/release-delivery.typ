// Release order and recovery. The sole editable source of this UML activity.
// The Taskfile release commands are sequential. Failure exits describe manual
// recovery, not automatic retries. A cut never loops to another version cut.
#import "_activity.typ": *
#import "_draw.typ": render

#let nodes = (
  initial("start"),
  partition("local", [Local work — no push],
    action("lock", [Acquire the release lock]),
    action("preflight", [Run the doctor and tap preflight]),
    action("prepare", [Prepare main and release notes]),
    action("recheck", [Repeat tap preflight, then task check]),
    action("preview", [Preview cargo-release]),
    decision("ready", [Passed?],
      down: branch([[yes]]),
      right: branch([[no]],
        outcome("before-write", [Correct the cause. \ Confirm no version write. \ Then restart the task.]))),
    action("cut", [Cut the selected version \ with cargo-release]),
    decision("cut-complete", [Cut complete?],
      down: branch([[yes]]),
      right: branch([[no]],
        outcome("partial-cut", [Complete the selected version. \ Inspect each local write. \ Create only a missing tag.]))),
    action("book", [Check the tag's book version \ with the released guard]),
    action("build", [Move main to the release commit. \ Build archives in target/dist.]),
    action("test", [Test the formula, then \ smoke-test every target]),
    decision("checked", [All passed?],
      down: branch([[yes]]),
      right: branch([[no]],
        outcome("local-failure", [Keep the cut local. \ Correct the cause. \ Check the tag, rebuild and test.]))),
  ),
  partition("public", [Public writes — first push of main],
    action("push", [Push main, then push the tag]),
    decision("pushed", [Both sent?],
      down: branch([[yes]]),
      right: branch([[no]],
        outcome("push-failure", [After build and smoke pass, \ retry only the missing push.]))),
    action("github", [Create the GitHub release \ with its three archives]),
    decision("assets", [Complete?],
      down: branch([[yes]]),
      right: branch([[no]],
        outcome("github-failure", [Complete this release \ and its three assets. \ Then resume the tap step.]))),
    action("tap", [Copy, commit and push \ the intended tap formula]),
    decision("tap-complete", [Complete?],
      down: branch([[yes]]),
      right: branch([[no]],
        outcome("tap-failure", [Retain local tap work. \ Finish only this formula change.]))),
  ),
  partition("installation", [Local installation and final checks],
    action("update", [Run brew update. \ Install or upgrade Ravel.]),
    action("verify", [Run brew test ravel. \ Check Ravel's version \ at the Homebrew prefix. \ Check GitHub's three assets.]),
    decision("installed", [All passed?],
      down: branch([[yes]]),
      right: branch([[no]],
        outcome("install-failure", [Correct the installation. \ Repeat its checks. \ Keep the same version.]))),
  ),
  final("done"),
)

#render(activity([Build, check and deliver a release — UML activity], nodes, (
  [Blue: sequential actions. Grey: stop and recover manually.],
  [A failure stops at its own step. Later actions do not run.],
  [Each guard covers the actions since the previous decision.],
  [Grey exits name recovery points in the chapter's recovery table.],
  [After a version write, keep that version. Do not start another version cut.],
  [A source/tag mismatch needs a decision. Never move a public tag.],
  [Task removes its lock on exit. After an abrupt stop, check for a live task first.],
)))
