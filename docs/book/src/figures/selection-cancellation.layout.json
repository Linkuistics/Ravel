    {
      "id": "key-text",
      "shape": "text",
      "role": "label",
      "face": "body",
      "text": "Blue: Ravel processes. Grey: caller and evaluation harness.\nHarness cleanup precedes worker teardown. The worker itself sends no signal.\nThis example sends INT directly to the Ravel CLI. It is not keyboard delivery.\nHUP and TERM give shell statuses 129 and 143 by the same cancellation rule.\nIf signal propagation fails, Ravel exits with the numeric status for that signal.\nCancellation reports attempted teardown, not a guarantee that cleanup succeeded.",
      "x": 314.07861328125,
      "y": 1139.88359375,
      "anchor": "center",
      "align": "center",
      "wrapped": false,
      "w": 588.1572265625,
      "h": 102.3203125
    }
