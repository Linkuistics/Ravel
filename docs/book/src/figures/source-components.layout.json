    {
      "id": "key-text",
      "shape": "text",
      "role": "label",
      "face": "body",
      "text": "Blue: Ravel code or process. Grey: external programs.\nDashed outline: components inside the Ravel CLI, not a sandbox.\nC4 components here are internal code. Ravel supports no separate component.\nThe runner has no separate process or installed executable.\nArrows name use or supervision, not a complete chronology.\nSkill preparation precedes the worker. The reader thread serves the host runtime.\nBefore managed launch: the worker ends. Ravel reaps it and removes its private directory.\nEvery host call ends first. Each harness run completes its required cleanup.\nHarness-run data returns to the configuration script. It cannot complete the final session.\nThe worker never receives the session-result context.\nTwo Rust packages: crates/ravel and crates/keyed-launch.\nThe CLI and Rhai worker are separate processes of the same installed executable.",
      "x": 419.5,
      "y": 1072.803125,
      "anchor": "center",
      "align": "center",
      "wrapped": false,
      "w": 635.0654296875,
      "h": 212.34062500000005
    }
