' Reuse the book palette and common settings; C4 macros draw no elements here.
!include <C4/C4_Context>
!include _style.puml
hide stereotype
skinparam databaseFontSize 16
skinparam sequence {
  ParticipantBackgroundColor #E8EDF2
  ParticipantBorderColor #64748B
  ParticipantFontColor #172B3A
  ParticipantFontSize 16
  ParticipantBorderThickness 1.5
  ParticipantBackgroundColor<<ravel>> #1E4F78
  ParticipantBorderColor<<ravel>> #163A59
  ParticipantFontColor<<ravel>> #FFFFFF
  ParticipantBackgroundColor<<temporary>> #FFF1CF
  ParticipantBorderColor<<temporary>> #8A6B26
  ParticipantFontColor<<temporary>> #3D321A
  LifeLineBorderColor #64748B
  ArrowColor #334155
  ArrowFontColor #172B3A
  ArrowFontSize 14
  ArrowThickness 1.5
  GroupBackgroundColor #F8FAFC
  GroupBorderColor #64748B
  GroupHeaderFontColor #172B3A
  GroupBorderThickness 1.5
  DividerBackgroundColor #E8EDF2
  DividerBorderColor #64748B
  DividerFontColor #172B3A
  DividerFontSize 14
  DividerBorderThickness 1.5
  ParticipantPadding 20
  MessageAlign center
}
skinparam state {
  BackgroundColor #1E4F78
  BorderColor #163A59
  FontColor #FFFFFF
  AttributeFontColor #FFFFFF
  FontSize 14
  BorderThickness 1.5
  BackgroundColor<<outcome>> #E8EDF2
  BorderColor<<outcome>> #64748B
  FontColor<<outcome>> #172B3A
}
skinparam componentStyle uml2
skinparam artifact {
  BackgroundColor #E8EDF2
  BorderColor #64748B
  FontColor #172B3A
  FontSize 14
  BorderThickness 1.5
  BackgroundColor<<executable>> #1E4F78
  BorderColor<<executable>> #163A59
  FontColor<<executable>> #FFFFFF
}
skinparam nodeBackgroundColor #F8FAFC
skinparam nodeBorderColor #64748B
skinparam nodeFontColor #172B3A
skinparam nodeFontSize 16
skinparam nodeBorderThickness 1.5
skinparam packageBackgroundColor #FFFFFF
skinparam packageBorderColor #64748B
skinparam packageFontColor #172B3A
skinparam packageFontSize 16
skinparam packageBorderThickness 1.5
<style>
stateDiagram {
  circle {
    start, stop, end {
      LineColor #334155
      BackgroundColor #334155
      LineThickness 1.5
    }
  }
}
sequenceDiagram {
  lifeLine {
    LineThickness 0.5
  }
  destroy {
    LineColor #334155
    LineThickness 1.5
  }
  participant, database {
    Padding 7
  }
}
</style>
