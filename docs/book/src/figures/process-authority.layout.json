    {
      "id": "key-text",
      "shape": "text",
      "role": "label",
      "face": "body",
      "text": "Blue: Ravel processes. Grey: external participants. Gold: temporary channel.\nGreen arrows carry the opaque result.\nThe LLM asks its harness to run end-session.\nThe managed process’s children inherit its session-result context.\nThe sent result asks Ravel to stop. Ravel returns only after successful cleanup.\n1 precedes 2: the worker and managed process are not concurrent phases.\nBefore 2: the worker ends. Ravel reaps it and removes its private directory.\nA valid selection alone is insufficient for launch.\nThe runner is library code inside the Ravel CLI, not another process.\nThe outer outline is software membership, not a sandbox.\nBoundaries do not authenticate same-user code or contain detached children.",
      "x": 355.0,
      "y": 1197.741796875,
      "anchor": "center",
      "align": "center",
      "wrapped": false,
      "w": 552.056640625,
      "h": 194.00390625000003
    }
