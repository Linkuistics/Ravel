    {
      "id": "key-text",
      "shape": "text",
      "role": "label",
      "face": "body",
      "text": "Blue: phases of Ravel’s work, not processes.\nGrey rounded boxes: outcomes; no further transition is shown.\nINT, TERM or HUP can cancel either phase and suppress any published value.\nCleanup is attempted on every path; attempts do not imply success.\nRavel keeps one primary outcome and reports other failures beside it.\nNo result means absent publication, even if the managed process exited 0.\nAn empty publication is a value; a later nonzero managed exit does not invalidate it.\nGreen: the only route to delivering a result successfully.\nA failed write may leave a prefix on stdout.\nThis view groups operations; it is not the full failure-precedence algorithm.",
      "x": 420.01025390625,
      "y": 730.146875,
      "anchor": "center",
      "align": "center",
      "wrapped": false,
      "w": 594.275390625,
      "h": 175.6671875
    }
