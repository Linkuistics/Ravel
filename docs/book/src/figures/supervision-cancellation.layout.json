    {
      "id": "key-text",
      "shape": "text",
      "role": "label",
      "face": "body",
      "text": "Blue: Ravel process. Grey: external participants. Gold cylinder: temporary files.\nGreen carries a sent value, but no green arrow reaches the caller.\nThe managed process’s group includes descendants that stay in that group.\nINT goes directly to the Ravel CLI here. Terminal Ctrl-C can reach only the group.\nHUP and TERM use shell statuses 129 and 143. If signal propagation fails, Ravel exits with the numeric status.\nCleanup problems cannot turn cancellation into success or permit result delivery.",
      "x": 530.32470703125,
      "y": 671.153125,
      "anchor": "center",
      "align": "center",
      "wrapped": false,
      "w": 773.1103515625,
      "h": 102.3203125
    }
