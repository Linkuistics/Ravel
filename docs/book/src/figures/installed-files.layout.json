    {
      "id": "key-text",
      "shape": "text",
      "role": "label",
      "face": "body",
      "text": "Blue: the executable. Grey: other files. Outlines group directories.\nThe file group lists separate files relative to share/ravel/examples.\nThe CLI starts the same bin/ravel as a separate Rhai worker and checks its identity.\nA skill source is installed by its own formula, not by Ravel.\nThe shared prefix link resolves through the keg alias to the source payload.\nThe worker is a process role, not another installed executable.\nThe owner copies and edits the examples. sample.rhai and llm.rhai import static.rhai.\nInstalled execution needs no separate language runtime or source checkout.\nTHIRD-PARTY-NOTICES.md lists notices for Rust dependencies.\nRelease archives additionally carry README.md and LICENSE at their root.",
      "x": 320.1796875,
      "y": 967.1046875,
      "anchor": "center",
      "align": "center",
      "wrapped": false,
      "w": 600.359375,
      "h": 175.6671875
    }
