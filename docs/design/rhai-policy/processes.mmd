flowchart TB
  start["Start here: the caller runs ravel start-session"]
  subgraph cli["Ravel CLI process — holds all authority"]
    direction TB
    auth["Entry and settings<br/>policy.rhai · harnesses<br/>budgets"]
    eval["Evaluation runtime<br/>deadline · cancellation · bounds<br/>environment"]
    reader["Reader thread<br/>entry · modules · measured reads<br/>program lookups"]
    runner["Runner<br/>jobs · group cleanup · reap"]
  end
  subgraph worker["Rhai worker — computes only"]
    direction TB
    rhai["Rhai 1.27.0 engine<br/>strict mode · fixed limits<br/>1 GiB heap"]
    mods["policy.rhai and<br/>imported modules"]
  end
  hrun["Harness run<br/>such as claude -p<br/>own result channel<br/>RAVEL_POLICY_RUN<br/>the owner's sign-in"]
  model[("Model service<br/>reached only<br/>by the harness")]
  start -->|"1 · flags, prompt, context"| auth
  auth -->|"2 · re-execute own binary"| eval
  eval <-->|"3 · host calls on fd 3"| rhai
  rhai --- mods
  eval -->|"4 · ravel::read_text and imports"| reader
  eval -->|"5 · run_harness, also an LLM call"| runner
  runner --> hrun
  hrun -->|"sign-in only here"| model
  classDef start fill:#20344d,color:#fff,stroke:#20344d,font-weight:bold
  classDef external fill:#eef3f8,color:#20344d,stroke:#6b7f95
  class start start
  class hrun,model external
