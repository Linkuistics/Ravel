flowchart TD
  start["Start here: start-session needs a configuration entry"]
  reentry{"Is RAVEL_CONFIG_RUN set?"}
  config{"Is --config given?"}
  ext{"What is the extension of --config?"}
  rhai{"Does ~/.config/ravel/config.rhai exist?"}
  ts{"Does ~/.config/ravel/policy.ts exist?"}
  eval["Evaluate the .rhai entry"]
  retired["Refuse: config_format_retired, exit 3<br/>the remedy names the Rhai configuration chapter"]
  missing["Refuse: config_missing, exit 3"]
  unreadable["Refuse: config_unreadable, exit 3"]
  reent["Refuse: config_reentry_refused, exit 3"]
  start --> reentry
  reentry -->|yes| reent
  reentry -->|no| config
  config -->|yes| ext
  ext -->|".rhai"| eval
  ext -->|".ts .mts .cts .js .mjs .cjs"| retired
  ext -->|"any other"| unreadable
  config -->|no| rhai
  rhai -->|"yes: policy.ts is not opened"| eval
  rhai -->|no| ts
  ts -->|yes| retired
  ts -->|no| missing
  classDef start fill:#20344d,color:#fff,stroke:#20344d,font-weight:bold
  class start start
