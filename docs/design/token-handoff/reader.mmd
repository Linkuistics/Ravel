flowchart TD
  start["Start here:<br/>CLAUDE_CODE_OAUTH_TOKEN_FILE_DESCRIPTOR=N"]:::start
  socket{"Is descriptor N<br/>a socket?"}
  direct["Read N directly, close it,<br/>then remove the variable"]
  path["Open /dev/fd/N by its path"]
  absent["Ravel's Seatbelt profile:<br/>ENOENT, the path is absent"]
  none["No direct read after ENOENT:<br/>not logged in"]
  signed["Signed in with the token"]
  start --> socket
  socket -->|yes| direct
  socket -->|no: pipe or file| path
  direct --> signed
  path -->|confined| absent
  absent --> none
  classDef start fill:#173451,color:#fff,stroke:#102a43,font-weight:bold
