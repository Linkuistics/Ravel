flowchart TB
  start["Start here: direct native caller"]
  entry["Caller chooses capture instant<br/>EntrySignals applies in child"]
  runner["Runner changes host handlers<br/>and ignored SIGCHLD<br/>foreground gates terminal lending"]
  returned["Success or core error returns<br/>host signal changes persist"]
  host["Host owes lifetime / restoration<br/>exclusive signal ownership<br/>no concurrency guarantee"]
  cli["CLI has pre-runtime capture<br/>guard restores INT/TERM/HUP<br/>front process ends"]
  start -->|"1. caller input and obligations"| entry
  entry -->|"2. launch"| runner
  runner -->|"3. returned outcome"| returned
  returned -->|"4. host resumes"| host
  cli -.->|"existing enabling points do not establish generic host restoration"| host
  classDef start fill:#20344d,color:#fff,stroke:#20344d,font-weight:bold
  classDef limit fill:#fff2d6,color:#3e2c08,stroke:#ae791a,stroke-dasharray:5 4
  class start start
  class returned,host limit
