flowchart TB
  start["Start here: immutable entry capture"]
  front["Front owns checked signal scope"]
  worker["Enable watching before worker<br/>Create shielded readers"]
  choice{"Selection outcome"}
  runner["Block and join<br/>Checked runner handler handoff"]
  child["Checked child state and spawn<br/>Fallible Started transition"]
  supervise["Runner owns stop, group cleanup,<br/>reap and terminal recovery"]
  settle["Common front finalisation<br/>Every outcome; handlers retained"]
  result{"All settlement checks passed<br/>and no cancellation?"}
  success["Release checked signal state<br/>Write exact bytes and exit"]
  failure["Retain all reports<br/>Signal or numeric failure and exit"]
  start -->|"1. complete record required"| front
  front -->|"2. no child after transition failure"| worker
  worker -->|"3. real worker reap gates admission"| choice
  choice -->|"4. success"| runner
  choice -->|"4. failure; keep front scope"| settle
  runner -->|"5. admission passes"| child
  runner -->|"5. failure; no ending"| settle
  child -->|"6. spawn-reported success or observer failure"| supervise
  child -->|"6. failed spawn and C4 recovery"| settle
  supervise -->|"7. ending or error plus first signal"| settle
  settle -->|"8. pending and late joins; explicit cleanup"| result
  result -->|"yes"| success
  result -->|"no"| failure
  classDef start fill:#20344d,color:#fff,stroke:#20344d,font-weight:bold
  class start start
