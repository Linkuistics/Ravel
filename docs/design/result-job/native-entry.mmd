flowchart TB
  start["Start here: one-session CLI"]
  entry["Capture ignores and mask<br/>before runtime"]
  authority["Own signals and terminal<br/>Enable child watching"]
  child["Apply child entry state<br/>INT follows foreground"]
  settle["Supervise, clean up, settle"]
  exit["Signal or exact bytes<br/>Exit this process"]
  host["Persistent runner<br/>Separate host contract"]
  start -->|"1. executable entry"| entry
  entry -->|"2. before worker and job"| authority
  authority -->|"3. launch after admitted selection"| child
  child -->|"4. cleanup on every returned path"| settle
  settle -->|"5. final CLI boundary"| exit
  exit -.->|"no arbitrary host-resumption promise"| host
  classDef start fill:#20344d,color:#fff,stroke:#20344d,font-weight:bold
  classDef limit fill:#fff2d6,color:#3e2c08,stroke:#ae791a,stroke-dasharray:5 4
  class start start
  class host limit
