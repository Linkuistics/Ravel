flowchart TD
  D["Start here: dialogue<br/>rule node"]:::start
  D --> S1["step 1 “opens”"]
  D --> L["loop node: question ↻<br/>pass rule: question"]:::loop
  L --> P1["pass 1"]:::pass
  L --> P2["pass 2"]:::pass
  L --> P3["pass 3, current"]:::pass
  P1 --> Q1["question"]
  Q1 --> S2["step 2 “asks”"]
  Q1 --> A1["answer"]
  A1 --> S3["step 3 “answers”"]
  P2 --> Q2["question"]
  Q2 --> S4["step 4 “asks”"]
  Q2 --> A2["answer"]
  A2 --> S5["step 5 “answers”"]
  P3 --> Q3["question"]
  Q3 --> S6["step 6 “asks”"]
  classDef start fill:#1d2330,color:#ffffff,font-weight:bold,stroke:#1d2330
  classDef loop fill:#efe6fb,stroke:#6b3fa0,color:#3d2163
  classDef pass fill:#e3f4ef,stroke:#0e7c66,color:#0b4d40
