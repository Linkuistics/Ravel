checked-grammar format-version=2 grammar-sha256="59de628ef10155e40c7695aff3aa161c188df78a83ac7c8263caa954ad0d70dc" {
    grammar-doc text="A tutorial step model. An LLM follows this grammar to write a tutorial,\none step at a time. Each step has a rule of its own, and the doc string\nof that rule tells the LLM what to write.\nThe \"set_exercise\" step carries a `file` attribute: the relative path\nof the starter file. Attributes never affect acceptance." start=5 end=349
    start-rule name=tutorial start=360 end=368
    rule name=tutorial start=372 end=380 {
        doc text="The whole tutorial." start=381 end=402
        sequence start=409 end=461 {
            reference name=overview start=409 end=417
            reference name=setup start=418 end=423
            repetition min=1 start=424 end=431 {
                reference name=lesson start=424 end=430
            }
            reference name=summarise start=432 end=441
            optional start=442 end=461 {
                reference name=suggest_next_steps start=442 end=460
            }
        }
    }
    rule name=setup start=465 end=470 {
        doc text="Prepare the machine of the reader: one install step for each tool." start=471 end=539
        sequence start=546 end=565 {
            repetition min=1 start=546 end=554 {
                reference name=install start=546 end=553
            }
            optional start=555 end=565 {
                reference name=configure start=555 end=564
            }
        }
    }
    rule name=lesson start=569 end=575 {
        doc text="One lesson teaches one concept, with one to three examples." start=576 end=637
        sequence start=644 end=710 {
            reference name=introduce_concept start=644 end=661
            repetition min=1 max=3 start=662 end=679 {
                reference name=show_example start=662 end=674
            }
            repetition min=0 start=680 end=689 {
                reference name=practice start=680 end=688
            }
            optional start=690 end=710 {
                reference name=check_understanding start=690 end=709
            }
        }
    }
    rule name=practice start=714 end=722 {
        doc text="One exercise, with its hints and its solution." start=723 end=771
        sequence start=778 end=815 {
            reference name=set_exercise start=778 end=790
            repetition min=0 start=791 end=801 {
                reference name=give_hint start=791 end=800
            }
            reference name=show_solution start=802 end=815
        }
    }
    rule name=overview start=834 end=842 {
        doc text="State what the reader builds and what the reader must know first." start=843 end=910
        symbol value=overview start=917 end=927
    }
    rule name=install start=931 end=938 {
        doc text="Tell the reader how to install one tool." start=939 end=981
        symbol value=install start=988 end=997
    }
    rule name=configure start=1001 end=1010 {
        doc text="Tell the reader how to configure the tools.\nLeave this step out when the defaults work." start=1011 end=1118
        symbol value=configure start=1125 end=1136
    }
    rule name=introduce_concept start=1140 end=1157 {
        doc text="Introduce one new concept in plain words." start=1158 end=1201
        symbol value=introduce_concept start=1208 end=1227
    }
    rule name=show_example start=1231 end=1243 {
        doc text="Show a short worked example of the concept." start=1244 end=1289
        symbol value=show_example start=1296 end=1310
    }
    rule name=set_exercise start=1314 end=1326 {
        doc text="Set an exercise.\nAttribute `file`: the relative path of the starter file." start=1327 end=1420
        symbol value=set_exercise start=1427 end=1441
    }
    rule name=give_hint start=1445 end=1454 {
        doc text="Give one hint for the current exercise." start=1455 end=1496
        symbol value=give_hint start=1503 end=1514
    }
    rule name=show_solution start=1518 end=1531 {
        doc text="Show the solution of the current exercise, and explain it." start=1532 end=1592
        symbol value=show_solution start=1599 end=1614
    }
    rule name=check_understanding start=1618 end=1637 {
        doc text="Ask two or three questions that check the concept." start=1638 end=1690
        symbol value=check_understanding start=1697 end=1718
    }
    rule name=summarise start=1722 end=1731 {
        doc text="Sum up what the reader learned." start=1732 end=1765
        symbol value=summarise start=1772 end=1783
    }
    rule name=suggest_next_steps start=1787 end=1805 {
        doc text="Point the reader to further material." start=1806 end=1845
        symbol value=suggest_next_steps start=1852 end=1872
    }
    symbol value=overview {
        use rule=overview start=917 end=927
    }
    symbol value=install {
        use rule=install start=988 end=997
    }
    symbol value=configure {
        use rule=configure start=1125 end=1136
    }
    symbol value=introduce_concept {
        use rule=introduce_concept start=1208 end=1227
    }
    symbol value=show_example {
        use rule=show_example start=1296 end=1310
    }
    symbol value=set_exercise {
        use rule=set_exercise start=1427 end=1441
    }
    symbol value=give_hint {
        use rule=give_hint start=1503 end=1514
    }
    symbol value=show_solution {
        use rule=show_solution start=1599 end=1614
    }
    symbol value=check_understanding {
        use rule=check_understanding start=1697 end=1718
    }
    symbol value=summarise {
        use rule=summarise start=1772 end=1783
    }
    symbol value=suggest_next_steps {
        use rule=suggest_next_steps start=1852 end=1872
    }
}
